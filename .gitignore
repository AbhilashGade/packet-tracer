### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is deliberately NOT ignored. These crates build binaries, not
# libraries, and the whole point of pinning aya is a reproducible build — an
# ignored lockfile would hand that back to whatever happened to resolve today.

# These are backup files generated by rustfmt
**/*.rs.bk

.DS_Store
